# WHOISWHO environment variables. Names only: NO real values here.
# Real values live in the server's .env (outside the web root, mode 600) and in
# GitHub Environment secrets. Never commit a real .env. See docs/architecture.md 6.3.

APP_NAME=WHOISWHO
APP_ENV=local            # local | staging | production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_TIMEZONE=Africa/Lagos

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
QUEUE_CONNECTION=database
CACHE_STORE=database
LOG_CHANNEL=daily
LOG_LEVEL=info

# Email (Brevo SMTP). Sending domain: wiwi.africa
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=WHOISWHO
BREVO_WEBHOOK_SECRET=

# Cloudflare (token scoped to Cache Purge on the wiwi.africa zone only)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Object storage (Cloudflare R2, S3-compatible). Two separate tokens.
MEDIA_DISK=r2
R2_MEDIA_ACCESS_KEY_ID=
R2_MEDIA_SECRET_ACCESS_KEY=
R2_MEDIA_BUCKET=
R2_MEDIA_ENDPOINT=
R2_MEDIA_PUBLIC_URL=
R2_BACKUP_ACCESS_KEY_ID=
R2_BACKUP_SECRET_ACCESS_KEY=
R2_BACKUP_BUCKET=
R2_BACKUP_ENDPOINT=
BACKUP_ARCHIVE_PASSWORD=

# Observability
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
HEALTHZ_TOKEN=

# AI drafting (flag ai_drafting stays OFF until Legal confirms the transfer)
ANTHROPIC_API_KEY=
AI_DRAFT_MODEL=
AI_PROMPT_VERSION=1

# Awards and compliance settings are stored in the database (settings, feature_flags),
# not here. Brand values live only in config/theme.php.
