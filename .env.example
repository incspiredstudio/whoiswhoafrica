# WHOISWHO environment names (WordPress build). Names only: NO real values here.
# Real values live in a secrets file OUTSIDE the web root (mode 600), loaded by the
# committed wp-config.php template, and in GitHub Environment secrets for deploys.
# Never commit a real secrets file. See docs/architecture.md 6.3.

# Site
WIWI_ENV=local                 # local | staging | production
WIWI_SITE_URL=http://localhost:8888
WIWI_TIMEZONE=Africa/Lagos
WIWI_DEBUG=false
# Production sets DISALLOW_FILE_EDIT, DISALLOW_FILE_MODS and DISABLE_WP_CRON in wp-config.php

# Database (cPanel MariaDB/MySQL)
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_TABLE_PREFIX=wp_

# WordPress keys and salts (generate per environment)
AUTH_KEY=
SECURE_AUTH_KEY=
LOGGED_IN_KEY=
NONCE_KEY=
AUTH_SALT=
SECURE_AUTH_SALT=
LOGGED_IN_SALT=
NONCE_SALT=

# Signing keys for single-use links and public form tokens (REQ-233)
WIWI_SIGNED_LINK_KEY=
WIWI_FORM_TOKEN_KEY=

# Email (cPanel mail SMTP through wp_mail). Sending domain: wiwi.africa
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=

# Later, optional: Cloudflare (token scoped to Cache Purge on the wiwi.africa zone only) and Turnstile
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Private files and import bundles (paths outside the web root)
PRIVATE_UPLOADS_DIR=
IMPORT_INBOX_DIR=

# Observability (optional)
ERROR_REPORTING_DSN=
HEALTHZ_TOKEN=

# Settings stored in the database, not here: thresholds, stream defaults, SLA targets, the pending-label
# wording, the import-all-as-not-public setting, the Nominations flag and its approval reference.
# Brand values live only in the theme tokens file. There is no AI provider key on the website:
# AI drafting belongs to the acquisition pipeline (D-037, REQ-165).
