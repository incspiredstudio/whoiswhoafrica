{
  "extends": "stylelint-config-standard",
  "ignoreFiles": [
    "dist/**",
    "build/coverage/**",
    "vendor/**",
    "node_modules/**",
    "wordpress/**",
    ".studio/**",
    "playwright-report/**",
    "test-results/**",
    "wp-content/plugins/two-factor/**",
    "wp-content/plugins/user-role-editor/**",
    "wp-content/plugins/wp-super-cache/**",
    "wp-content/plugins/action-scheduler/**"
  ],
  "overrides": [
    {
      "files": ["wp-content/themes/whoiswho/assets/css/base.css", "wp-content/themes/whoiswho/assets/css/components.css"],
      "rules": {
        "no-descending-specificity": null,
        "no-duplicate-selectors": null,
        "declaration-block-no-duplicate-properties": null,
        "property-no-deprecated": null
      }
    }
  ],
  "rules": {
    "value-keyword-case": null,
    "alpha-value-notation": null,
    "color-function-notation": null,
    "selector-class-pattern": null,
    "custom-property-pattern": null,
    "font-family-name-quotes": null
  }
}
