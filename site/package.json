{
  "name": "whoiswho-site",
  "version": "0.2.0",
  "private": true,
  "description": "Build tooling for the WHOISWHO WordPress site",
  "scripts": {
    "build": "node build/build.mjs && node build/theme-json.mjs --check",
    "lint:js": "eslint .",
    "lint:css": "stylelint \"**/*.css\" --allow-empty-input",
    "test:e2e": "playwright test",
    "package": "bash bin/package-release.sh",
    "build:sample": "node build/build.mjs --sample",
    "theme-json": "node build/theme-json.mjs",
    "theme-json:check": "node build/theme-json.mjs --check"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "stylelint": "^18.0.0",
    "stylelint-config-standard": "^41.0.0",
    "typescript": "^7.0.2"
  }
}
