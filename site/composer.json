{
  "name": "whoiswho/site",
  "description": "WHOISWHO WordPress site",
  "type": "project",
  "license": "proprietary",
  "repositories": [{ "type": "composer", "url": "https://wpackagist.org", "only": ["wpackagist-plugin/*", "wpackagist-theme/*"] }],
  "require": {
    "php": ">=8.3",
    "johnpbloch/wordpress-core": "^7.1",
    "nikic/php-parser": "^5.9",
    "woocommerce/action-scheduler": "^4.2"
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true,
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "composer/installers": true,
      "phpstan/extension-installer": true
    }
  },
  "extra": { "wordpress-install-dir": "wordpress" },
  "scripts": {
    "lint": "phpcs",
    "lint:fix": "phpcbf",
    "analyse": "phpstan analyse --memory-limit=1G --no-progress",
    "test": "echo no tests yet"
  },
  "require-dev": {
    "dealerdirect/phpcodesniffer-composer-installer": "^1.2",
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "phpstan/extension-installer": "^1.4",
    "phpstan/phpstan": "^2.3",
    "phpunit/phpunit": "^10",
    "szepeviktor/phpstan-wordpress": "^2.0",
    "wp-coding-standards/wpcs": "^3.4",
    "yoast/phpunit-polyfills": "^2.0"
  }
}
